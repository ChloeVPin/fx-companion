#!/usr/bin/env bash
# fxc — fx-companion booster manager.
#   fxc sync           rebuild from PINNED_FX
#   fxc sync --latest  probe origin/main; advance the pin only if gates pass
#   fxc status         show whether the running fx binary carries the booster
set -euo pipefail

FXC_HOME="${FX_COMPANION_HOME:-$HOME/.fx-companion}"
HERE="$(cd "$(dirname "$0")" && pwd)"

die() { echo "fxc: $*" >&2; exit 1; }

cmd="${1:-}"
case "$cmd" in
  sync)
    shift || true
    exec bash "$HERE/sync.sh" "${1:-}"
    ;;
  status)
    bin="$(command -v fx || true)"
    [ -n "$bin" ] || die "no fx on PATH"
    echo "fx binary: $bin"
    if strings "$bin" 2>/dev/null | grep -c "FX_NO_COMPANION" | grep -qv '^0$'; then
      echo "booster: PRESENT"
    else
      echo "booster: absent (stock fx)"
    fi
    if [ -f "$FXC_HOME/PINNED_FX" ]; then
      echo "pin: $(tr -d '[:space:]' < "$FXC_HOME/PINNED_FX")"
    fi
    ;;
  *)
    sed -n '2,6p' "$0"
    exit 1
    ;;
esac
