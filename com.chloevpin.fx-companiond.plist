<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.chloevpin.fx-companiond</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/chloe/dev/fx-companion/zig-out/bin/fx-companiond</string>
    </array>

    <!-- On-demand: launchd owns dev.fx.companion and spawns us at first lookup -->
    <key>MachServices</key>
    <dict>
        <key>dev.fx.companion</key>
        <true/>
    </dict>

    <!-- Without this launchd runs the daemon at a background QoS tier,
         throttling walk threads to ~1/3 of their in-process speed.
         Measured on the 409k anchor: ~293 ms vs ~104 ms local. -->
    <key>ProcessType</key>
    <string>Interactive</string>

    <!-- Exit after idle so RSS target stays trivially met -->
    <key>IdleTimeout</key>
    <integer>300</integer>
</dict>
</plist>
